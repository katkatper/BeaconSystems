DATABASE_URL=postgresql+psycopg2://postgres:change_me@127.0.0.1:5432/Beacon_Systems
# Or use separate database settings instead of DATABASE_URL:
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=Beacon_Systems
DB_USER=postgres
DB_PASSWORD=change_me
DB_SSLMODE=prefer
DB_SSLROOTCERT=global-bundle.pem

SECRET_KEY=change_me_to_a_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
BEACON_CASE_ACCESS_CODE=change_me

# Optional production geocoding. Keep this key on the backend only.
ARCGIS_GEOCODING_ENABLED=false
ARCGIS_API_KEY=change_me
ARCGIS_GEOCODE_FOR_STORAGE=true
ARCGIS_GEOCODE_MIN_SCORE=80
ARCGIS_GEOCODE_TIMEOUT_SECONDS=5
