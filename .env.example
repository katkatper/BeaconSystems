# Runtime mode: development, test, or production
ENVIRONMENT=development

# Required database connection
DATABASE_URL=postgresql+psycopg2://beacon:change-me@localhost:5432/beacon
# Alembic only: privileged schema-owner connection. Do not expose this to the API runtime.
MIGRATION_DATABASE_URL=postgresql+psycopg2://beacon_migrator:change-me@localhost:5432/beacon
# Or use separate database settings instead of DATABASE_URL:
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=Beacon_Systems
DB_USER=postgres
DB_PASSWORD=change_me
DB_SSLMODE=prefer
DB_SSLROOTCERT=global-bundle.pem

# Required in production; use a secret manager and at least 32 random characters
SECRET_KEY=replace-with-a-long-random-secret
# Dedicated HMAC key and non-secret version identifier for tamper-evident audit events.
AUDIT_INTEGRITY_KEY=
AUDIT_INTEGRITY_KEY_ID=
# Separate Fernet key for MFA secrets. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_SECRET_ENCRYPTION_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=beacon-api
JWT_AUDIENCE=beacon-web
BEACON_CASE_ACCESS_CODE=

# Comma-separated HTTPS origins. Required in production; wildcards are rejected.
CORS_ORIGINS=
# Comma-separated API hostnames accepted in the HTTP Host header.
TRUSTED_HOSTS=localhost,127.0.0.1
# Production requires at least one year. Applied only in production.
HSTS_MAX_AGE_SECONDS=31536000

# Development convenience only. Production must set this to false and run Alembic.
ENABLE_LOCAL_SCHEMA_BOOTSTRAP=true

# SQLAlchemy connection-pool controls
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_SLOW_QUERY_MS=500
API_REQUEST_TIMEOUT_SECONDS=30
# Slow production dependency probes are cached to keep load-balancer traffic cheap.
READINESS_DEPENDENCY_CACHE_SECONDS=300
EXTERNAL_API_TIMEOUT_SECONDS=10
AWS_CONNECT_TIMEOUT_SECONDS=5
AWS_READ_TIMEOUT_SECONDS=10
MAX_UPLOAD_BYTES=26214400

# Upload malware scanning. Production requires a reachable ClamAV daemon and
# rejects uploads whenever scanning is unavailable or malware is detected.
MALWARE_SCAN_BACKEND=disabled
MALWARE_SCAN_HOST=127.0.0.1
MALWARE_SCAN_PORT=3310
MALWARE_SCAN_TIMEOUT_SECONDS=15

# API process controls. Use one worker per autoscaled container by default.
API_BIND_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_GRACEFUL_SHUTDOWN_SECONDS=30
# Set to the trusted load-balancer/proxy addresses or CIDR ranges.
FORWARDED_ALLOW_IPS=127.0.0.1

# Durable asynchronous worker controls
WORKER_ID=
WORKER_POLL_SECONDS=1
WORKER_LEASE_SECONDS=300
WORKER_RETRY_BASE_SECONDS=30
WORKER_HEARTBEAT_TIMEOUT_SECONDS=60
JOB_COMPLETED_RETENTION_DAYS=30
JOB_DEAD_LETTER_RETENTION_DAYS=180
WORKER_HEARTBEAT_RETENTION_DAYS=7
WORKER_MAINTENANCE_INTERVAL_SECONDS=300
QUEUE_BACKLOG_WARNING=1000

# Distributed authentication abuse protection. Production requires a shared
# TLS-enabled Redis/ElastiCache endpoint so limits apply across all API workers.
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TIMEOUT_SECONDS=5
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
MFA_RATE_LIMIT_ATTEMPTS=10
MFA_RATE_LIMIT_WINDOW_SECONDS=300
REFRESH_RATE_LIMIT_ATTEMPTS=60
REFRESH_RATE_LIMIT_WINDOW_SECONDS=60

# Partner and evidence configuration
PARTNER_WEBHOOK_TOKEN=
EVIDENCE_ENCRYPTION_ENABLED=false
EVIDENCE_ENCRYPTION_KEY_ID=local-storage

# Shared object storage. Production requires s3 and a bucket name.
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_BUCKET=
# Customer-managed KMS key ARN or key ID used for all stored evidence.
OBJECT_STORAGE_KMS_KEY_ID=
# Twelve-digit AWS account that must own the evidence bucket.
OBJECT_STORAGE_EXPECTED_OWNER=
OBJECT_STORAGE_PREFIX=beacon
OBJECT_STORAGE_LOCAL_ROOT=uploads
OBJECT_STORAGE_SIGNED_URL_TTL_SECONDS=300

# Optional integrations
SPLUNK_HEC_URL=
SPLUNK_HEC_TOKEN=
ARCGIS_GEOCODING_ENABLED=false
ARCGIS_API_KEY=
ARCGIS_GEOCODE_FOR_STORAGE=true
ARCGIS_GEOCODE_MIN_SCORE=80
ARCGIS_GEOCODE_TIMEOUT_SECONDS=5
