# Runtime mode: development, test, or production
ENVIRONMENT=development

# Required database connection
DATABASE_URL=postgresql+psycopg2://beacon:change-me@localhost:5432/beacon
# Alembic only: privileged schema-owner connection. Do not expose this to the API runtime.
MIGRATION_DATABASE_URL=postgresql+psycopg2://beacon_migrator:change-me@localhost:5432/beacon
# Or use separate database settings instead of DATABASE_URL:
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=Beacon_Systems
DB_USER=postgres
DB_PASSWORD=change_me
DB_SSLMODE=prefer
DB_SSLROOTCERT=global-bundle.pem

# Required in production; use a secret manager and at least 32 random characters
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=beacon-api
JWT_AUDIENCE=beacon-web
BEACON_CASE_ACCESS_CODE=change_me

# Comma-separated HTTPS origins. Required in production; wildcards are rejected.
CORS_ORIGINS=
# Comma-separated API hostnames accepted in the HTTP Host header.
TRUSTED_HOSTS=localhost,127.0.0.1
# Production requires at least one year. Applied only in production.
HSTS_MAX_AGE_SECONDS=31536000

# Development convenience only. Production must set this to false and run Alembic.
ENABLE_LOCAL_SCHEMA_BOOTSTRAP=true

# SQLAlchemy connection-pool controls
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_SLOW_QUERY_MS=500
API_REQUEST_TIMEOUT_SECONDS=30
MAX_UPLOAD_BYTES=26214400

# API process controls. Use one worker per autoscaled container by default.
API_BIND_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
# Set to the trusted load-balancer/proxy addresses or CIDR ranges.
FORWARDED_ALLOW_IPS=127.0.0.1

# Partner and evidence configuration
PARTNER_WEBHOOK_TOKEN=
EVIDENCE_ENCRYPTION_ENABLED=false
EVIDENCE_ENCRYPTION_KEY_ID=local-storage

# Shared object storage. Production requires s3 and a bucket name.
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_PREFIX=beacon
OBJECT_STORAGE_LOCAL_ROOT=uploads
OBJECT_STORAGE_SIGNED_URL_TTL_SECONDS=300

# Optional integrations
SPLUNK_HEC_URL=
SPLUNK_HEC_TOKEN=
ARCGIS_GEOCODING_ENABLED=false
ARCGIS_API_KEY=
ARCGIS_GEOCODE_FOR_STORAGE=true
ARCGIS_GEOCODE_MIN_SCORE=80
ARCGIS_GEOCODE_TIMEOUT_SECONDS=5
