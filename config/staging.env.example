# Copy into an access-controlled secret store; never commit populated values.
ENVIRONMENT=staging
# Database URLs are injected by compose from BEACON_STAGING_DB_PASSWORD.
SECRET_KEY=CHANGE_ME_32_OR_MORE_RANDOM_CHARACTERS
AUDIT_INTEGRITY_KEY=CHANGE_ME_32_OR_MORE_RANDOM_CHARACTERS
AUDIT_INTEGRITY_KEY_ID=staging-2026-01
MFA_SECRET_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY
MFA_ENFORCEMENT_ENABLED=true
JWT_ISSUER=beacon-staging-api
JWT_AUDIENCE=beacon-staging-web
BEACON_CASE_ACCESS_CODE=CHANGE_ME_RANDOM_ACCESS_CODE
CORS_ORIGINS=http://localhost:8080
TRUSTED_HOSTS=localhost,127.0.0.1,api
ENABLE_LOCAL_SCHEMA_BOOTSTRAP=false
MALWARE_SCAN_BACKEND=clamav
MALWARE_SCAN_HOST=clamav
MALWARE_SCAN_PORT=3310
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_LOCAL_ROOT=/data/evidence
OBJECT_STORAGE_BUCKET=staging-local-only
OBJECT_STORAGE_KMS_KEY_ID=staging-local-only
OBJECT_STORAGE_EXPECTED_OWNER=000000000000
RATE_LIMIT_REDIS_URL=redis://redis:6379/0
API_WORKERS=2
API_GRACEFUL_SHUTDOWN_SECONDS=30
