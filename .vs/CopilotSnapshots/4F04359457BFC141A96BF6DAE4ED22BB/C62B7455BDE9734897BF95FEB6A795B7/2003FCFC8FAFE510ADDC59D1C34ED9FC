import os
import uuid
from typing import Optional, Tuple

import boto3
from botocore.exceptions import ClientError


class S3Service:
    """Simple wrapper around boto3 S3 client.

    Credentials are read from environment variables as usual for boto3:
    AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_SESSION_TOKEN (optional),
    and AWS_REGION (or AWS_DEFAULT_REGION).
    """

    def __init__(self, region: Optional[str] = None):
        self.region = region or os.getenv("AWS_REGION") or os.getenv("AWS_DEFAULT_REGION")
        # If explicit credentials are set in environment, create a session with them,
        # otherwise boto3 will use its default credential chain.
        access_key = os.getenv("AWS_ACCESS_KEY_ID")
        secret_key = os.getenv("AWS_SECRET_ACCESS_KEY")
        session_token = os.getenv("AWS_SESSION_TOKEN")

        if access_key and secret_key:
            session = boto3.Session(
                aws_access_key_id=access_key,
                aws_secret_access_key=secret_key,
                aws_session_token=session_token,
                region_name=self.region,
            )
            self.client = session.client("s3")
        else:
            self.client = boto3.client("s3", region_name=self.region)

    def list_buckets(self):
        try:
            resp = self.client.list_buckets()
            return [b.get("Name") for b in resp.get("Buckets", [])]
        except ClientError as e:
            raise

    def create_bucket(self, bucket_name: str) -> None:
        params = {"Bucket": bucket_name}
        try:
            if self.region and self.region != "us-east-1":
                params["CreateBucketConfiguration"] = {"LocationConstraint": self.region}
            self.client.create_bucket(**params)
        except ClientError:
            raise

    def upload_bytes(self, bucket_name: str, key: str, data: bytes, content_type: Optional[str] = None) -> None:
        params = {"Bucket": bucket_name, "Key": key, "Body": data}
        if content_type:
            params["ContentType"] = content_type
        try:
            self.client.put_object(**params)
        except ClientError:
            raise

    def download_bytes(self, bucket_name: str, key: str) -> bytes:
        try:
            resp = self.client.get_object(Bucket=bucket_name, Key=key)
            return resp["Body"].read()
        except ClientError:
            raise

    def delete_object(self, bucket_name: str, key: str) -> None:
        try:
            self.client.delete_object(Bucket=bucket_name, Key=key)
        except ClientError:
            raise

    def empty_and_delete_bucket(self, bucket_name: str) -> None:
        # Remove all objects (and object versions if versioning is enabled)
        try:
            # First try to delete all object versions (if any)
            paginator = self.client.get_paginator("list_object_versions")
            for page in paginator.paginate(Bucket=bucket_name):
                deletes = {"Objects": []}
                for key in page.get("Versions", []) + page.get("DeleteMarkers", []):
                    deletes["Objects"].append({"Key": key["Key"], "VersionId": key.get("VersionId")})
                if deletes["Objects"]:
                    self.client.delete_objects(Bucket=bucket_name, Delete=deletes)
        except ClientError:
            # If versioning/listing versions not allowed, fall back to simple list/delete
            pass

        try:
            paginator = self.client.get_paginator("list_objects_v2")
            for page in paginator.paginate(Bucket=bucket_name):
                objects = page.get("Contents", [])
                if not objects:
                    continue
                deletes = {"Objects": [{"Key": o["Key"]} for o in objects]}
                self.client.delete_objects(Bucket=bucket_name, Delete=deletes)
            # Finally delete bucket
            self.client.delete_bucket(Bucket=bucket_name)
        except ClientError:
            raise

    def test_bucket(self, prefix: str = "beacon-test") -> Tuple[bool, str]:
        """Create a temporary bucket, upload/download a test object, then clean up.

        Returns (success, message).
        """
        bucket = f"{prefix}-{uuid.uuid4().hex[:8]}"
        key = "test.txt"
        try:
            self.create_bucket(bucket)
            self.upload_bytes(bucket, key, b"hello from boto3", content_type="text/plain")
            data = self.download_bytes(bucket, key)
            if data.decode("utf-8") != "hello from boto3":
                return False, "uploaded and downloaded content mismatch"
            return True, f"succeeded with bucket {bucket}"
        except Exception as e:
            return False, str(e)
        finally:
            try:
                self.delete_object(bucket, key)
            except Exception:
                pass
            try:
                self.empty_and_delete_bucket(bucket)
            except Exception:
                pass


__all__ = ["S3Service"]




